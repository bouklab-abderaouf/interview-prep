NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC_

GEMINI_API_KEY=                     # server only. Never reaches the browser.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # verify against `models.list` — Live model IDs churn, see specs §11
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite   # optional. Used when the primary is overloaded (503) or out of quota (429) — free-tier quotas are per model

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

DEMO_MAX_SESSIONS_PER_DAY=20            # provisional; derive from the real Live quota — docs/CAPACITY.md
DEMO_MAX_SESSIONS_PER_IP_PER_HOUR=2
DEMO_SESSION_MAX_SECONDS=120
FULL_SESSION_MAX_SECONDS=600
KILL_SWITCH_OVERRIDE=false          # manual "everything off" lever
IP_HASH_SALT=                       # not in specs §2 verbatim — needed for sessions.ip_hash = sha256(ip + salt), specs §3. Any random string.

# Per-user daily limits (UTC day) on everything that spends Gemini quota —
# lib/limits.ts. Provisional until derived from the real quota (docs/CAPACITY.md).
USER_MAX_ANALYSES_PER_DAY=3
USER_MAX_SCORINGS_PER_DAY=15
USER_MAX_INTERVIEWS_PER_DAY=10
USER_MAX_DRILLS_PER_DAY=20
USER_MAX_SESSIONS_PER_DAY=40

ENABLE_VOICE_SMOKE_TEST=            # "1" to allow the stage-less voice test (/session/x) in production; always on in dev
CSP_REPORT_ONLY=                    # "1" sends the CSP as report-only — the escape hatch if it blocks something real
NEXT_PUBLIC_SIGNIN_CAPTCHA=         # "1" adds Turnstile to sign-in. Enable Bot protection in Supabase Auth FIRST, same keys

# Error tracking (Sentry, EU region) — docs/RUNBOOK.md. Nothing is sent, and
# Sentry isn't initialised, while these are empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=                         # optional; falls back to NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_ENVIRONMENT=     # production / preview
